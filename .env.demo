# Public portfolio demo build (frontend todo #51 / backend #82).
# Loaded by `npm run build:demo` (vite --mode demo). Gates all demo behavior:
# auto-login as a seeded throwaway user, samples-only upload UI, demo banner,
# hidden logout. The normal home-server build does NOT set these.
#
# These creds are intentionally public — a non-admin shared sandbox account on a
# daily-reset droplet. Do not treat the frontend as a security boundary.
VITE_DEMO_MODE=1
VITE_DEMO_EMAIL=demo@pocketwatcher.local
VITE_DEMO_PASSWORD=Password123!
