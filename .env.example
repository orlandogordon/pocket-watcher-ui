# Frontend env vars. Copy to .env.local (gitignored) and set as needed.
# Two ways to point the app at a backend — pick one:

# 1) DEV PROXY (recommended for `npm run dev`): the Vite dev server proxies /api
#    to this target, so the browser stays same-origin with the dev server and
#    there's no CORS to configure. Leave VITE_API_URL unset (client uses "/api").
#    Default if unset: http://localhost:8000
# VITE_API_PROXY_TARGET=http://<home-server-ip>:8000

# 2) DIRECT API base (e.g. a production build with no dev-server proxy): the
#    browser calls this URL directly. Requires the backend's CORS_ORIGINS to
#    allow this app's origin. If unset, the client falls back to "/api".
# VITE_API_URL=https://api.example.com

# PUBLIC DEMO BUILD (todo #51): the demo flags live in the committed `.env.demo`
# and are baked in by `npm run build:demo` (vite --mode demo). The normal build
# (`npm run build`) leaves VITE_DEMO_MODE unset, so demo behavior is fully off.
# VITE_DEMO_MODE=1
# VITE_DEMO_EMAIL=demo@pocketwatcher.local
# VITE_DEMO_PASSWORD=Password123!
